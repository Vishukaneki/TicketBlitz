# Server Port
PORT=3000
NODE_ENV=development

# Database Connections
# Application runtime queries use PgBouncer (Port 6432, Transaction Pooling):
DATABASE_URL="postgresql://bms2:bms2password@localhost:6432/bms2db?pgbouncer=true&connection_limit=15"

# Direct PostgreSQL connection (Port 5432, used for Prisma migrations):
DIRECT_DATABASE_URL="postgresql://bms2:bms2password@localhost:5432/bms2db"

# Redis Configuration (Auth + BullMQ + Socket.IO Adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bms2redis
REDIS_URL="redis://:bms2redis@localhost:6379"

# Security & Authentication
JWT_SECRET="ticketblitz_super_secure_jwt_secret_key_change_in_prod"

# Search Engine (Elasticsearch)
ELASTICSEARCH_NODE="http://localhost:9200"

# CORS Configuration
CORS_ORIGIN="*"

# Email / Notifications (Nodemailer / SMTP)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"
